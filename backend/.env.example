# Local dev (Docker Compose postgres):
DATABASE_URL=postgresql+asyncpg://auditpulse:auditpulse@localhost:5432/auditpulse
# Supabase (production) — use the "Transaction pooler" connection string
# from Supabase: Project Settings -> Database -> Connection string ->
# Transaction pooler (port 6543), with postgresql:// swapped for
# postgresql+asyncpg://. Do NOT use the "Session pooler" (port 5432) —
# it holds one real Postgres connection per app connection for the
# connection's whole lifetime and Supabase caps that at a small number
# of total clients (15 on smaller tiers), which this app's multiple
# processes (web, worker, beat) will exceed almost immediately,
# producing "max clients reached in session mode" on startup. The
# transaction pooler multiplexes many app connections over a much
# smaller number of real Postgres connections instead. Example:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500

# Optional: enables the AI-generated summaries/action plans in ai/
ANTHROPIC_API_KEY=
# Optional: enables real PageSpeed scoring in performance/
GOOGLE_PAGESPEED_API_KEY=
