{
       "$schema": "https://railway.app/railway.schema.json",
       "build": {
         "builder": "DOCKERFILE",
         "dockerfilePath": "Dockerfile"
       },
       "deploy": {
         "startCommand": "sh -c \"celery -A workers.celery_worker worker --loglevel=info\"",
         "restartPolicyType": "ON_FAILURE",
         "restartPolicyMaxRetries": 3
       }
     }
