# Local dev (Docker Compose postgres):
DATABASE_URL=postgresql+asyncpg://auditpulse:auditpulse@localhost:5432/auditpulse
# Supabase (production) — use the "Session pooler" connection string from
# Supabase: Project Settings -> Database -> Connection string -> Session
# pooler, with postgresql:// swapped for postgresql+asyncpg://. Example:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500

# Optional: enables the AI-generated summaries/action plans in ai/
ANTHROPIC_API_KEY=
# Optional: enables real PageSpeed scoring in performance/
GOOGLE_PAGESPEED_API_KEY=
