# AuditPulse backend settings for the Oracle server.
# Copy to auditpulse.env, fill the <...> values (from Railway), never commit it.
APP_ENV=production
DEBUG=false
SECRET_KEY=<long random string, 48+ chars>
DATABASE_URL=<Supabase connection string, postgresql+asyncpg://...>
CORS_ORIGINS_RAW=<https://your-auditpulse.vercel.app,https://your-access-portal.vercel.app>
ACCESS_PORTAL_API_KEY=<shared key; same value as AUDITPULSE_API_KEY in access.env>
# AI: "groq" (free tier, key from console.groq.com) or "anthropic"
AI_PROVIDER=groq
GROQ_API_KEY=<optional>
ANTHROPIC_API_KEY=<optional>
GOOGLE_PAGESPEED_API_KEY=<optional>
SMTP_HOST=<optional>
SMTP_PORT=587
SMTP_USERNAME=<optional>
SMTP_PASSWORD=<optional>
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=<optional>
SMTP_FROM_NAME=AuditPulse
LOG_TO_FILE=false
# REDIS_URL / CELERY_* are set by docker-compose.yml (internal Redis).
