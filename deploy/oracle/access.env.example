# Access portal settings for the server (AWS today).
# Copy to access.env, fill in the <...> values, never commit it.
DATABASE_URL=<Supabase connection string for the portal>
AUDITPULSE_API_KEY=<same value as ACCESS_PORTAL_API_KEY in auditpulse.env>
AUDITPULSE_TIMEOUT_SECONDS=15
PORTAL_JWT_SECRET=<long random string>
PORTAL_ACCESS_TOKEN_TTL=<from Railway>
PORTAL_BASE_URL=<https://auditpulse-access-<ip>.sslip.io once known>
FRONTEND_BASE_URL=<https://your-access-portal.vercel.app>
CORS_ORIGINS_RAW=<https://your-access-portal.vercel.app,https://your-auditpulse.vercel.app>
# AUDITPULSE_BASE_URL is set by docker-compose.yml (internal network).
