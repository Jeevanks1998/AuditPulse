# Local development (Docker Compose Postgres):
DATABASE_URL=postgresql+asyncpg://auditpulse:auditpulse@localhost:5432/auditpulse
# Supabase: use the "Transaction pooler" string (port 6543) with postgresql+asyncpg://.
# The "Session pooler" (port 5432) runs out of connections ("max clients reached").
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500

# Access Portal integration. Must equal AUDITPULSE_API_KEY in AuditPulse-Access.
# Leave blank to turn the integration off.
ACCESS_PORTAL_API_KEY=

# Optional: AI summaries and recommendations (or set AI_PROVIDER=groq + GROQ_API_KEY).
ANTHROPIC_API_KEY=
# Optional: Google PageSpeed scoring.
GOOGLE_PAGESPEED_API_KEY=
